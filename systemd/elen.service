[Unit]
Description=Elen 2.0 personal assistant daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.elen.Assistant
ExecStart=@VENV@/bin/elen daemon
EnvironmentFile=-%h/.config/elen/env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
